<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android only -->
		<TargetFrameworks>net9.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>Fyla.Host.Android</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>Fyla.Host.Android</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.fyla.host.android</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Platform support -->
		<SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>

		<!-- Android SDK path -->
		<AndroidSdkTools>C:\Program Files (x86)\Android\android-sdk\platform-tools</AndroidSdkTools>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="EmbedIO" Version="3.5.2" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.8" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Watson" Version="6.4.0" />
	</ItemGroup>

	<Target Name="ReversePortAfterDeploy" AfterTargets="_Upload">
		<Exec Command="&quot;$(AndroidSdkTools)\adb.exe&quot; forward tcp:28112 tcp:28111" ContinueOnError="true" />
	</Target>

</Project>

